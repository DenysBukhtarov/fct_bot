# Скопіюйте цей файл у .env і вставте свій токен від @BotFather
# Приклад: BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# Необов'язково: Telegram ID додаткових адмінів через кому (дізнатись — команда /myid)
ADMIN_IDS=

# Необов'язково: база Postgres (Supabase) — щоб попередження не скидались після перезапуску
DATABASE_URL=

# Для локального запуску залиште порожнім (режим polling).
# На Render заповнювати не треба — адреса береться автоматично.
WEBHOOK_URL=
