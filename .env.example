# Скопіюйте цей файл у .env і вставте свій токен від @BotFather
# Приклад: BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# Ваш Telegram ID (дізнатись — команда /myid). Кілька адмінів — через кому.
# Сюди приходять заявки на запис і квитанції про оплату.
ADMIN_IDS=

# База Postgres (Supabase, Session pooler) — для запису, оплат, абонементів і попереджень
DATABASE_URL=

# Необов'язково: ключ для адреси нагадувань /cron/tick (інакше генерується з токена)
CRON_SECRET=

# Для локального запуску залиште порожнім (режим polling).
# На Render заповнювати не треба — адреса береться автоматично.
WEBHOOK_URL=
